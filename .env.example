# === Devin API (v3) ===
# Service user API key from https://app.devin.ai/settings/service-users (starts with cog_)
DEVIN_API_KEY=cog_replace_me
# Org ID from https://app.devin.ai/settings/organizations (format: org-<32-hex>)
DEVIN_ORG_ID=org-replace_me
DEVIN_API_BASE=https://api.devin.ai

# === GitHub ===
# Fine-grained PAT with repo-scoped permissions: Contents/Issues/PullRequests R/W, Metadata R.
GITHUB_TOKEN=github_pat_replace_me
TARGET_REPO=ezraodio/superset
ISSUE_LABEL=devin-remediation
GITHUB_API_BASE=https://api.github.com

# === Scanner → orchestrator auth ===
# Shared secret required in the X-Ingest-Secret header on /ingest and /verify/result.
INGEST_SHARED_SECRET=change-me-to-a-long-random-string

# === Policy ===
# Minimum severity to act on (LOW | MEDIUM | HIGH | CRITICAL).
MIN_SEVERITY=HIGH
# CVSS floor; findings below the severity threshold are still kept if CVSS >= this.
MIN_CVSS=7.0
# Default branch in the target repo (Superset's fork uses master).
TARGET_BASE_BRANCH=master
# DRY_RUN=true creates tracking issues but does not dispatch Devin.
DRY_RUN=false
# MOCK_MODE=true stubs out Devin + GitHub clients (for local testing).
MOCK_MODE=false

# === Storage ===
ORCHESTRATOR_DB_PATH=/data/orchestrator.db
